{
  "name": "@esport237hub/ui",
  "version": "0.1.0",
  "description": "Design system ESPORT 237 HUB basé sur Astryx (Meta) — tokens, thème light/dark, composants web (React) et natifs (React Native).",
  "license": "MIT",
  "author": "ESPORT 237 HUB",
  "repository": {
    "type": "git",
    "url": "https://github.com/JPITH/esport237hub-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens": "./src/tokens/index.ts",
    "./theme": "./src/theme/esport237.ts",
    "./theme.css": "./src/theme/theme.css",
    "./components.css": "./src/theme/components.css",
    "./scrollbar.css": "./src/theme/scrollbar.css",
    "./css": "./src/css/global.css",
    "./lib": "./src/lib/index.ts",
    "./skins": "./src/skins/index.ts",
    "./web": "./src/web/index.tsx",
    "./web/astryx": "./src/web/astryx.ts",
    "./web/fields": "./src/web/fields.tsx",
    "./native": "./src/native/index.tsx",
    "./native/expo": "./src/native/expo/index.tsx"
  },
  "scripts": {
    "typecheck": "bun scripts/tsc7.ts -p tsconfig.web.json && bun scripts/tsc7.ts -p tsconfig.native.json",
    "lint": "bun scripts/tsc7.ts -p tsconfig.web.json --noEmit",
    "test": "bun test src",
    "icons": "bun scripts/icons.ts",
    "icons:check": "bun scripts/icons.ts --check",
    "shapes": "bun scripts/card-shapes.ts",
    "shapes:check": "bun scripts/card-shapes.ts --check"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.8",
    "@astryxdesign/theme-neutral": "0.1.8",
    "@stylexjs/stylex": "^0.19.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-native": "*",
    "react-native-svg": "*",
    "react-native-reanimated": "*",
    "react-native-gesture-handler": "*",
    "react-native-safe-area-context": "*",
    "react-native-keyboard-controller": "*",
    "@esport237hub/types": "*",
    "@expo/ui": "*"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-keyboard-controller": {
      "optional": true
    },
    "@esport237hub/types": {
      "optional": true
    },
    "@expo/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@esport237hub/types": "workspace:*",
    "@expo/ui": "~58.0.22",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-native": "^0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.0.0",
    "react-native-svg": "^15.0.0",
    "svgo": "^4.0.2",
    "typescript7": "npm:typescript@7.0.2"
  }
}
